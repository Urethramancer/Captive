@inc test
@inc src/editing

fn testInlineReplacementAndCaret(t:test.Tester)
{
	f=new editing.Field; f.Begin("name",0,"Rook")
	_=f.Input(78); _=f.Input(101); _=f.Input(111)
	t.equalStr(f.Text,"Neo","typing replaces selected name")
	_=f.Input(28); _=f.Input(8); _=f.Input(97)
	t.equalStr(f.Text,"Nao","backspace and insertion use caret")
	_=f.Input(127)
	t.equalStr(f.Text,"Na","forward delete removes next character")
	_=f.Input(30); _=f.Input(65); _=f.Input(31); _=f.Input(49)
	t.equalStr(f.Text,"ANa1","home and end support insertion")
	_=f.Input(1); _=f.Input(8)
	t.equalStr(f.Text,"","select all and delete clears field")
	t.equal(f.Input(13),1,"Enter requests commit")
	t.equal(f.Input(27),2,"Escape requests cancellation")
}

fn testInlineLimitsAndInvalidInput(t:test.Tester)
{
	for kind=["name","password"]
	{
		f=new editing.Field; f.Begin(kind,0,"")
		for i=0; i<40; i+=1 { _=f.Input(65) }
		limit:int64=19; if kind=="password" { limit=32 }
		t.equal(len(f.Text),limit,"field enforces its length limit")
		_=f.Input(1); _=f.Input(32); _=f.Input(233)
		t.equal(len(f.Text),limit,"invalid characters preserve selection and text")
		_=f.Input(66)
		t.equalStr(f.Text,"B","valid character replaces selection even at limit")
	}
}
