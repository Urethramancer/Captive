@mod session
@inc strings

// parseCell accepts only the export's bounded, unsigned decimal or hex cells.
fn parseCell(text:string, base:int64, limit:int64) int64,error
{
	if len(text) < 1 or len(text) > 5 { ret 0,error("base: invalid cell length") }
	value:int64 = 0
	for ch = strbytes(text)
	{
		digit = int64(ch) - 48
		if ch >= 97 and ch <= 102 { digit = int64(ch) - 87 }
		if ch >= 65 and ch <= 70 { digit = int64(ch) - 55 }
		if digit < 0 or digit >= base { ret 0,error("base: invalid cell digit") }
		value = value*base+digit
		if value > limit { ret 0,error("base: cell exceeds limit") }
	}
	ret value,nil
}

// LoadBase reads the recovered row-major DOS MapGen seed-0000 memory export.
// The caller supplies the ignored original-derived TSV, never a generated stand-in.
fn LoadBase(text:string) State,error
{
	if len(text) > 131072 { ret nil,error("base: export too large") }
	lines = strings.SplitLines(strings.Trim(text))
	if len(lines) != 2049 or lines[0] != "x\ty\tterrain\tobject\tdetail"
	{ ret nil,error("base: expected 64 by 32 recovered export") }
	terrain = new([]int64); objects = new([]int64); details = new([]int64); tiles = new([]int64)
	for index = 0; index < 2048; index += 1
	{
		cells = strings.Split(lines[index+1],"\t")
		if len(cells) != 5 { ret nil,error("base: invalid row") }
		x,e = parseCell(cells[0],10,63); if e != nil { ret nil,e }
		y,e = parseCell(cells[1],10,31); if e != nil { ret nil,e }
		if x != index%64 or y != index/64 { ret nil,error("base: rows out of order") }
		a,e = parseCell(cells[2],16,65535); if e != nil { ret nil,e }
		b,e = parseCell(cells[3],16,65535); if e != nil { ret nil,e }
		c,e = parseCell(cells[4],16,65535); if e != nil { ret nil,e }
		append(terrain,a); append(objects,b); append(details,c)
		walkable:int64 = 0
		if a > 0 and a < 32768 { walkable = 1 }
		append(tiles,walkable)
	}
	s,e = New(64,32,tiles,30,1,0)
	if e != nil { ret nil,e }
	s.Terrain = terrain; s.Objects = objects; s.Details = details
	s.Facing = 2
	ret s,nil
}

// LoadFixtures installs the separately recovered original wall-fixture registry.
fn LoadFixtures(s:State,text:string) error
{
	lines = strings.SplitLines(strings.Trim(text))
	if len(lines) < 2 or len(lines) > 101 { ret error("base fixtures: invalid registry length") }
	if lines[0] != "x\ty\ttype\textra" { ret error("base fixtures: invalid header") }
	types = new([]int64); extras = new([]int64)
	for at = 0; at < s.Width*s.Height; at += 1 { append(types,-1); append(extras,0) }
	for index = 1; index < len(lines); index += 1
	{
		fields = strings.Split(lines[index],"\t")
		if len(fields) != 4 { ret error("base fixtures: invalid record") }
		x,e = parseCell(fields[0],10,s.Width-1); if e != nil { ret e }
		y,e = parseCell(fields[1],10,s.Height-1); if e != nil { ret e }
		type,e = parseCell(fields[2],10,5); if e != nil { ret e }
		extra,e = parseCell(fields[3],10,255); if e != nil { ret e }
		types[y*s.Width+x] = type; extras[y*s.Width+x] = extra
	}
	s.FixtureTypes = types; s.FixtureExtra = extras
	ret nil
}

// LoadTraps reads the original cupboard-to-remote-wall registry.
fn LoadTraps(s:State,text:string) error
{
	lines = strings.SplitLines(strings.Trim(text))
	if len(lines) < 1 or len(lines) > 129 or lines[0] != "cupboardX\tcupboardY\twallX\twallY"
	{ ret error("base traps: invalid registry") }
	walls = new([]int64)
	for at = 0; at < s.Width*s.Height; at += 1 { append(walls,-1) }
	for index = 1; index < len(lines); index += 1
	{
		fields = strings.Split(lines[index],"\t")
		if len(fields) != 4 { ret error("base traps: invalid record") }
		x,e = parseCell(fields[0],10,s.Width-1); if e != nil { ret e }
		y,e = parseCell(fields[1],10,s.Height-1); if e != nil { ret e }
		wx,e = parseCell(fields[2],10,s.Width-1); if e != nil { ret e }
		wy,e = parseCell(fields[3],10,s.Height-1); if e != nil { ret e }
		walls[y*s.Width+x] = wy*s.Width+wx
	}
	s.TrapWall = walls
	ret nil
}
