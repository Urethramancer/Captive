@mod session

// advanceWorld uses provisional60Hz movement/attack pacing. The exact original
// encounter individuals and statistics come from Populate, never spawn tables.
fn advanceWorld(s:State)
{
	for at = 0; at < len(s.DoorOpen); at += 1
	{ if s.DoorOpen[at] > 0 { s.DoorOpen[at] -= 1 } }
	for e = s.Enemies
	{
		living = false
		for h = e.Health { if h > 0 { living = true } }
		if !living or (e.Kind == "Brains" and !e.Angry) { continue }
		e.Timer -= 1
		if e.Timer > 0 { continue }
		e.Timer = 90
		dx = s.X-e.X; dy = s.Y-e.Y
		if dx < 0 { dx = -dx }; if dy < 0 { dy = -dy }
		if dx+dy == 1
		{
			victim = s.Formation[NextRandom(s,2)]
			d = s.Droids[victim]
			if Alive(d)
			{
				part = NextRandom(s,6)
				damage = 1+NextRandom(s,3)
				d.Parts[part] -= damage
				if d.Parts[part] < 0 { d.Parts[part] = 0 }
				append(s.SoundEvents,"hurt")
			}
			continue
		}
		if dx+dy > 6 { continue }
		x = e.X; y = e.Y
		if dx >= dy { if s.X > x { x += 1 } else { x -= 1 } }
		else { if s.Y > y { y += 1 } else { y -= 1 } }
		if (x != s.X or y != s.Y) and Walkable(s,x,y) and EnemyAt(s,x,y) < 0
		{
			for loot = s.Loot
			{ if loot.Kind == "clue" and loot.Value == 2 and loot.X == e.X and loot.Y == e.Y { loot.X = x; loot.Y = y } }
			e.X = x; e.Y = y
		}
	}
}
